 the first sample Vasya make 3 pairwise perpendicular cuts. He cuts monster on two parts with the first cut, then he divides each part on two with the second cut, and finally he divides each of the 4 parts on two.","type":"text"}],"contestId":73,"index":"A","memoryLimit":"256 megabytes","name":"The Elder Trolls IV Oblivon","problemKey":"73-A","rating":null,"tags":[],"timeLimit":"2 seconds","url":"https://codeforces.com/contest/73/problem/A"},{"approaches":[{"label":"Approach 1","number":1,"solutions":[{"code":"","fileName":"main.cpp","language":"cpp"}]},{"label":"Approach 2","number":2,"solutions":[{"code":"","fileName":"main.cpp","language":"cpp"}]},{"label":"Approach 3","number":3,"solutions":[{"code":"","fileName":"main.cpp","language":"cpp"}]},{"label":"Approach 4","number":4,"solutions":[{"code":"","fileName":"main.cpp","language":"cpp"}]},{"label":"Approach 5","number":5,"solutions":[{"code":"","fileName":"main.cpp","language":"cpp"}]},{"label":"Approach 6","number":6,"solutions":[{"code":"","fileName":"main.cpp","language":"cpp"}]},{"label":"Approach 7","number":7,"solutions":[{"code":"","fileName":"main.cpp","language":"cpp"}]},{"label":"Approach 8","number":8,"solutions":[{"code":"","fileName":"main.cpp","language":"cpp"}]},{"label":"Approach 9","number":9,"solutions":[{"code":"","fileName":"main.cpp","language":"cpp"}]},{"label":"Approach 10","number":10,"solutions":[{"code":"","fileName":"main.cpp","language":"cpp"}]},{"label":"Approach 11","number":11,"solutions":[{"code":"","fileName":"main.cpp","language":"cpp"}]},{"label":"Approach 12","number":12,"solutions":[{"code":"","fileName":"main.cpp","language":"cpp"}]},{"label":"Approach 13","number":13,"solutions":[{"code":"","fileName":"main.cpp","language":"cpp"}]},{"label":"Approach 14","number":14,"solutions":[{"code":"","fileName":"main.cpp","language":"cpp"}]},{"label":"Approach 15","number":15,"solutions":[{"code":"","fileName":"main.cpp","language":"cpp"}]},{"label":"Approach 16","number":16,"soluti