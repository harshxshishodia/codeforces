swer.\n\n## Examples\n\nExample 1:\n```\nabab\n```\n```\nab\n```","type":"text"}],"contestId":72,"index":"E","memoryLimit":"256 megabytes","name":"Ali goes shopping","problemKey":"72-E","rating":null,"tags":[],"timeLimit":"5 seconds","url":"https://codeforces.com/contest/72/problem/E"},{"approaches":[{"label":"Approach 1","number":1,"solutions":[{"code":"","fileName":"main.cpp","language":"cpp"}]},{"label":"Approach 2","number":2,"solutions":[{"code":"","fileName":"main.cpp","language":"cpp"}]},{"label":"Approach 3","number":3,"solutions":[{"code":"","fileName":"main.cpp","language":"cpp"}]},{"label":"Approach 4","number":4,"solutions":[{"code":"","fileName":"main.cpp","language":"cpp"}]},{"label":"Approach 5","number":5,"solutions":[{"code":"","fileName":"main.cpp","language":"cpp"}]},{"label":"Approach 6","number":6,"solutions":[{"code":"","fileName":"main.cpp","language":"cpp"}]},{"label":"Approach 7","number":7,"solutions":[{"code":"","fileName":"main.cpp","language":"cpp"}]},{"label":"Approach 8","number":8,"solutions":[{"code":"","fileName":"main.cpp","language":"cpp"}]},{"label":"Approach 9","number":9,"solutions":[{"code":"","fileName":"main.cpp","language":"cpp"}]},{"label":"Approach 10","number":10,"solutions":[{"code":"","fileName":"main.cpp","language":"cpp"}]},{"label":"Approach 11","number":11,"solutions":[{"code":"","fileName":"main.cpp","language":"cpp"}]},{"label":"Approach 12","number":12,"solutions":[{"code":"","fileName":"main.cpp","language":"cpp"}]},{"label":"Approach 13","number":13,"solutions":[{"code":"","fileName":"main.cpp","language":"cpp"}]},{"label":"Approach 14","number":14,"solutions":[{"code":"","fileName":"main.cpp","language":"cpp"}]},{"label":"Approach 15","number":15,"solutions":[{"code":"","fileName":"main.cpp","language":"cpp"}]},{"label":"Approach 16","number":16,"solutions":[{"code":"","fileName":"main.cpp","language":"cpp"}]},{"label":"Approach 17","number":17,"solutions":[{"code":"","fileName":"main.cpp","language":"cpp"}]}