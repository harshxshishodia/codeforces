se less than 9 columns.","type":"text"}],"contestId":68,"index":"E","memoryLimit":"256 megabytes","name":"Contact","problemKey":"68-E","rating":null,"tags":[],"timeLimit":"3 seconds","url":"https://codeforces.com/contest/68/problem/E"}],"schemaVersion":1}
